<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vp="using:WindFlow.App.Viewport"
        xmlns:app="using:WindFlow.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="WindFlow.App.MainWindow"
        Icon="avares://WindFlow.App/Assets/windflow.ico"
        Title="WindFlow"
        Width="1680" Height="940" MinWidth="1180" MinHeight="620"
        Background="{DynamicResource Canvas}"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

  <!-- BorderOnly: the system frame, shadow and resize edges stay, the system title bar (icon, title, caption buttons) does
       not; this window draws that bar itself. The taskbar and Alt-Tab still read Title and Icon. -->
  <!-- What each mode shows and what Lock disables is not decided here: UiTable.cs names the containers below
       (ExpertViewTools, ExpertPanes, WindGroup, ...) and ApplyMode / SetLocked drive them from that table.
       Layout (Rhino / Fusion): the title bar carries the project menu, the workflow steps and the few big actions; the
       command bar under it holds the tools of the current step; the panel on the right is tabbed; one status strip. -->
  <Grid RowDefinitions="44,40,*,28">

    <!-- ============ title bar, merged: the empty area drags the window, a double-click maximises (OnTitleBarPress) ============ -->
    <Border Grid.Row="0" x:Name="TopBar" Background="{DynamicResource Panel}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="OnTitleBarPress">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Accent}">
            <app:Icon Data="{StaticResource IconWind}" Width="12" Height="12" Stroke="2.6" Foreground="{DynamicResource AccentFg}" />
          </Border>
          <TextBlock Text="WindFlow" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,2,0" />
          <!-- the project menu: open, save, the sample house and the exports; the button reads the model's name -->
          <Button x:Name="ProjectMenuButton" Classes="ghost" MinHeight="32" CornerRadius="8" Padding="10,0,8,0"
                  ToolTip.Tip="Open, save, the sample house and the exports.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="ProjectMenuText" Text="No model" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
              <app:Icon Classes="s" Data="{StaticResource IconChevronDown}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
                <Border x:Name="ProjectMenuCard" Classes="card menuCard" Button.Click="OnMenuItemClick">
                  <StackPanel>
                    <Button x:Name="OpenModelButton" Classes="menu" Click="OnOpenModel"
                            ToolTip.Tip="A model exported from Revit (.json), or geometry: OBJ, glTF, FBX, STL, 3DS, DAE.">
                      <Grid ColumnDefinitions="26,*,Auto">
                        <app:Icon Data="{StaticResource IconFolderOpen}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="Open model…" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="kbd" Text="Ctrl+O" />
                      </Grid>
                    </Button>
                    <Button x:Name="SaveModelButton" Classes="menu" Click="OnSaveModel"
                            ToolTip.Tip="Save the model with your edits (devices, open and closed windows, discharge coefficients, occupants, names) as a .windflow.json that Open model… reads back.">
                      <Grid ColumnDefinitions="26,*,Auto">
                        <app:Icon Data="{StaticResource IconSave}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="Save model…" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="kbd" Text="Ctrl+S" />
                      </Grid>
                    </Button>
                    <Button x:Name="SampleButton" Classes="menu" Click="OnSampleBuilding" ToolTip.Tip="Load the two-storey sample house.">
                      <Grid ColumnDefinitions="26,*">
                        <app:Icon Data="{StaticResource IconHouse}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="Open sample building" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <Border Classes="menuSep" />
                    <Button Classes="menu" Click="OnExportReport" Content="Export PDF report"
                            ToolTip.Tip="A PDF report: the room table, a plan at 1.1 m of every analysed storey and a long section.">
                      <Button.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="26,*">
                            <app:Icon Data="{StaticResource IconFileText}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </Button.ContentTemplate>
                    </Button>
                    <!-- video exports, Expert only (UiTable row) -->
                    <StackPanel x:Name="ExportVideoGroup">
                      <Button x:Name="TurntableItem" Classes="menu" Click="OnExportTurntable">
                        <Grid ColumnDefinitions="26,*">
                          <app:Icon Data="{StaticResource IconFilm}" HorizontalAlignment="Left" />
                          <TextBlock Grid.Column="1" Text="Turntable video, 12 s" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                      <Button x:Name="RecordMenuItem" Classes="menu" Click="OnExportRecord">
                        <Grid ColumnDefinitions="26,*">
                          <app:Icon Data="{StaticResource IconVideo}" HorizontalAlignment="Left" />
                          <TextBlock x:Name="RecordMenuText" Grid.Column="1" Text="Record video" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <!-- the workflow: where you are from Model to Report. Each step opens what already exists (OnWorkflow).
             At the 1180 DIP minimum it is the one thing that gives way: it clips on the right, the actions stay whole. -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="sep" />
          <Border x:Name="WorkflowTabs" Classes="segment" Margin="2,0,0,0">
            <StackPanel>
              <Button x:Name="WfModel" Classes="wf" Tag="0" Click="OnWorkflow" ToolTip.Tip="Model: open a building, the sample house, save. Rooms and openings are in the panel.">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="n"><Panel><TextBlock Text="1" /><app:Icon Data="{StaticResource IconCheck}" Stroke="3.2" /></Panel></Border>
                  <TextBlock Text="Model" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="WfWind" Classes="wf" Tag="1" Click="OnWorkflow" ToolTip.Tip="Wind: where it comes from and how fast (the pill on the command bar).">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="n"><Panel><TextBlock Text="2" /><app:Icon Data="{StaticResource IconCheck}" Stroke="3.2" /></Panel></Border>
                  <TextBlock Text="Wind" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="WfSimulate" Classes="wf" Tag="2" Click="OnWorkflow" ToolTip.Tip="Simulate: Run, then watch the air; the View tab sets the cut and the still-air threshold.">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="n"><Panel><TextBlock Text="3" /><app:Icon Data="{StaticResource IconCheck}" Stroke="3.2" /></Panel></Border>
                  <TextBlock Text="Simulate" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="WfResults" Classes="wf" Tag="3" Click="OnWorkflow" ToolTip.Tip="Results: each room's fresh air, in the Rooms tab.">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="n"><Panel><TextBlock Text="4" /><app:Icon Data="{StaticResource IconCheck}" Stroke="3.2" /></Panel></Border>
                  <TextBlock Text="Results" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="WfReport" Classes="wf" Tag="4" Click="OnWorkflow" ToolTip.Tip="Report: export the PDF.">
                <StackPanel Orientation="Horizontal">
                  <Border Classes="n"><Panel><TextBlock Text="5" /><app:Icon Data="{StaticResource IconCheck}" Stroke="3.2" /></Panel></Border>
                  <TextBlock Text="Report" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- the big actions: Run (the one filled button), Export PDF, the mode, then the quiet icons and the caption buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Stretch">
          <Button x:Name="RunButton" VerticalAlignment="Center" Classes="primary" Content="Run" Click="OnRun" MinWidth="92"
                  ToolTip.Tip="Start the solver (Space pauses and resumes).">
            <Button.ContentTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <app:Icon Data="{Binding Converter={StaticResource RunIcon}}" Stroke="2.4" />
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </Button.ContentTemplate>
          </Button>
          <Button x:Name="ReportButton" Classes="secondary" Content="Export PDF" Click="OnExportReport"
                  ToolTip.Tip="A PDF report: the room table, a plan at 1.1 m of every analysed storey and a long section.">
            <Button.ContentTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <app:Icon Data="{StaticResource IconFileText}" />
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </Button.ContentTemplate>
          </Button>
          <Border Classes="segment">
            <StackPanel>
              <ToggleButton x:Name="BasicToggle" Classes="seg" Content="Basic" Click="OnBasicMode"
                            ToolTip.Tip="Load, wind, openings, run, rooms, PDF. Nothing else." />
              <ToggleButton x:Name="ExpertToggle" Classes="seg" Content="Expert" Click="OnExpertMode"
                            ToolTip.Tip="Everything else: simulation box, devices, slices, probes, compare, best windows, annual, video." />
            </StackPanel>
          </Border>
          <Border Classes="sep" />
          <ToggleButton x:Name="LockToggle" Classes="ghost icon lock" Click="OnLock"
                        ToolTip.Tip="Lock this result: the solver stops so the GPU is free, the air keeps flowing through the averaged field, and anything that would change the flow is greyed out. Click again to unlock and carry on from here.">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
              <app:Icon Classes="open" Data="{StaticResource IconLockOpen}" />
              <app:Icon Classes="closed" Data="{StaticResource IconLock}" />
              <TextBlock x:Name="LockGlyph" Classes="glyph" Text="&#xE785;" IsVisible="False" />
              <TextBlock x:Name="LockText" Text="Lock" VerticalAlignment="Center" IsVisible="False" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="PanelToggle" Classes="ghost icon" IsChecked="True" Click="OnTogglePanel" ToolTip.Tip="Show or hide the side panel.">
            <app:Icon Data="{StaticResource IconPanelRight}" />
          </ToggleButton>
          <Button x:Name="HelpButton" Classes="ghost icon" ToolTip.Tip="Help: how WindFlow works, the Technical Reference and the tour">
            <app:Icon Data="{StaticResource IconCircleHelp}" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                <Border x:Name="HelpMenuCard" Classes="card menuCard" Button.Click="OnMenuItemClick">
                  <StackPanel>
                    <Button x:Name="HelpMethodItem" Classes="menu" Content="How WindFlow works (2-page PDF)" HorizontalContentAlignment="Left" Click="OnOpenMethod" />
                    <Button x:Name="HelpTechRefItem" Classes="menu" Content="Technical Reference (PDF)" HorizontalContentAlignment="Left" Click="OnOpenTechRef" />
                    <Button x:Name="HelpTourItem" Classes="menu" Content="Take the tour" HorizontalContentAlignment="Left" Click="OnTakeTour" />
                    <Border Classes="menuSep" />
                    <Button x:Name="HelpUpdateItem" Classes="menu" Content="Check for updates" HorizontalContentAlignment="Left" Click="OnHelpUpdate" />
                    <Button x:Name="HelpContactItem" Classes="menu" Content="Contact / report a problem" HorizontalContentAlignment="Left" Click="OnContact" />
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="GearButton" Classes="ghost icon" Click="OnSettings" ToolTip.Tip="Settings">
            <app:Icon Data="{StaticResource IconSettings}" />
          </Button>
          <!-- caption buttons, drawn here with the system roles so Windows 11 snap layouts and the usual clicks work -->
          <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" Margin="4,0,0,0">
            <Button x:Name="CaptionMinimize" Classes="caption" chrome:WindowDecorationProperties.ElementRole="MinimizeButton" Click="OnCaptionMinimize" ToolTip.Tip="Minimise">
              <app:Icon Data="{StaticResource IconMinus}" Width="12" Height="12" Stroke="1.6" />
            </Button>
            <Button x:Name="CaptionMaximize" Classes="caption" chrome:WindowDecorationProperties.ElementRole="MaximizeButton" Click="OnCaptionMaximize" ToolTip.Tip="Maximise">
              <app:Icon Data="{StaticResource IconSquare}" Width="11" Height="11" Stroke="1.6" />
            </Button>
            <Button x:Name="CaptionClose" Classes="caption close" chrome:WindowDecorationProperties.ElementRole="CloseButton" Click="OnCaptionClose" ToolTip.Tip="Close">
              <app:Icon Data="{StaticResource IconX}" Width="12" Height="12" Stroke="1.6" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ command bar: the tools of the current step. At the 1180 DIP minimum the left group scrolls (S4-03); the legend stays put. ============ -->
    <Border Grid.Row="1" x:Name="CommandBar" Background="{DynamicResource Panel}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0,14,0">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

            <!-- Wind: one pill reading "W 270° · 4 m/s"; the pop-over holds the compass, the slider and the exact boxes
                 (the same WindDirBox / WindSpeedBox the solver, the drag arrow and the live link write). Disabled while locked (UiTable). -->
            <StackPanel x:Name="WindGroup" Orientation="Horizontal">
              <Button x:Name="WindPill" Classes="secondary pill" Click="OnWindPill"
                      ToolTip.Tip="Where the wind comes from and how fast it blows at 10 m. Click to set it on a compass; you can also drag the arrow in the view.">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <app:Icon Data="{StaticResource IconCompass}" Foreground="{DynamicResource TextMuted}" />
                  <TextBlock x:Name="WindPillText" Text="W 270° · 4 m/s" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <app:Icon Classes="s caret" Data="{StaticResource IconChevronDown}" />
                </StackPanel>
              </Button>
              <Popup x:Name="WindPopup" PlacementTarget="{Binding #WindPill}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                     IsLightDismissEnabled="True">
                <Border x:Name="WindCard" Classes="card" Width="304" Padding="14,12,14,12" IsEnabled="{Binding #WindGroup.IsEffectivelyEnabled}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="section" Text="WIND" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="rowSub" Text="drag the dial · snaps to 5°" />
                    </Grid>
                    <app:CompassDial x:Name="WindDial" HorizontalAlignment="Center" Margin="0,2,0,2"
                                     Accent="{DynamicResource Accent}" Ring="{DynamicResource Border}" Face="{DynamicResource Surface}" Label="{DynamicResource TextMuted}" />
                    <Grid ColumnDefinitions="52,Auto,Auto,*" ColumnSpacing="8">
                      <TextBlock Classes="unit" Text="from" />
                      <TextBox x:Name="WindDirBox" Grid.Column="1" Classes="field" Text="270" Width="56"
                               ToolTip.Tip="Where the wind comes from, degrees clockwise from north (270 = from the west). You can also drag the arrow in the view." />
                      <TextBlock Grid.Column="2" Classes="unit" Text="°" />
                      <TextBlock x:Name="WindCardinalText" Grid.Column="3" Classes="rowSub" Text="clockwise from north · W" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="52,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Classes="unit" Text="speed" />
                      <Slider x:Name="WindSpeedSlider" Grid.Column="1" Minimum="0" Maximum="40" Value="4" TickFrequency="0.5" IsSnapToTickEnabled="True"
                              ValueChanged="OnWindSpeedSlider" VerticalAlignment="Center" />
                      <TextBox x:Name="WindSpeedBox" Grid.Column="2" Classes="field" Text="4" Width="56" ToolTip.Tip="Wind speed at 10 m height, 0 to 40 m/s." />
                      <TextBlock Grid.Column="3" Classes="unit" Text="m/s" />
                    </Grid>
                    <TextBlock Classes="rowSub" Text="At 10 m height. The arrow in the view can be dragged too." />
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>

            <!-- everything past the wind needs a model: hidden with the viewport in the empty state, as the old view header was -->
            <StackPanel x:Name="ModelTools" Orientation="Horizontal" Spacing="8" IsVisible="{Binding #Viewport3D.IsVisible}">
            <!-- Which recipe the Accurate pass runs. Standard is the steady-wind answer; High adds gusts and supply turbulence
                 and so reports ranges. The time budget and the fine box belong to High only. Disabled while locked (UiTable). -->
            <StackPanel x:Name="AccurateControls" Orientation="Horizontal" Spacing="6">
              <Border Classes="segment small">
                <StackPanel>
                  <ToggleButton x:Name="AccurateStandardToggle" Classes="seg small" Content="Standard" IsChecked="True" Click="OnAccurateMode"
                                ToolTip.Tip="Standard: a perfectly steady wind and smooth supplies, up to 10 minutes (large models end time-limited). Rooms ventilated mainly by gusts (one opening, or windows only on walls parallel to the wind) read low: compare with High." />
                  <ToggleButton x:Name="AccurateHighToggle" Classes="seg small" Content="High" Click="OnAccurateMode"
                                ToolTip.Tip="High (gusty wind): gusty wind (EN 1991-1-4 turbulence) and turbulent supplies, averaged for the time budget you pick. The numbers move batch to batch, so each room shows a ± range; a gusty answer can sit outside Standard's range. Not more accurate than Standard: it models a different wind. The fine box and memory plan assume the Compact wind domain (headless High runs use Compact)." />
                  <ToggleButton x:Name="AccurateUltraToggle" Classes="seg small" Content="Ultra" Click="OnAccurateMode" ToolTip.ShowOnDisabled="True"
                                ToolTip.Tip="Ultra: the finest grid your GPU fits, as fine as the narrowest open window or door needs (16 cells across), run for hours (6 to 24 h, saved as it goes so it can resume). Wind only, no thermal. Accuracy not separately validated. A confirm dialog shows the estimate first." />
                </StackPanel>
              </Border>
              <StackPanel x:Name="UltraCapGroup" Orientation="Horizontal" Spacing="4" IsVisible="False"
                          ToolTip.Tip="Time limit of the Ultra run, hours. It stops earlier when every room has settled. Applies to the next Ultra run and is remembered.">
                <Border Classes="segment small">
                  <StackPanel>
                    <ToggleButton x:Name="UCap6Toggle" Classes="seg small" Content="6" Tag="6" Click="OnUltraCap" />
                    <ToggleButton x:Name="UCap12Toggle" Classes="seg small" Content="12" Tag="12" Click="OnUltraCap" />
                    <ToggleButton x:Name="UCap20Toggle" Classes="seg small" Content="20" Tag="20" Click="OnUltraCap" />
                    <ToggleButton x:Name="UCap24Toggle" Classes="seg small" Content="24" Tag="24" Click="OnUltraCap" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="unit" Text="h" Margin="2,0,0,0" />
              </StackPanel>
              <StackPanel x:Name="HighCapGroup" Orientation="Horizontal" Spacing="4" IsVisible="False"
                          ToolTip.Tip="Time budget of the High pass, minutes of stepping. It stops at the budget whatever the ranges are, and says so. Applies to the next pass and is remembered.">
                <Border Classes="segment small">
                  <StackPanel>
                    <ToggleButton x:Name="Cap5Toggle" Classes="seg small" Content="5" Tag="5" Click="OnAccurateCap" />
                    <ToggleButton x:Name="Cap10Toggle" Classes="seg small" Content="10" Tag="10" Click="OnAccurateCap" />
                    <ToggleButton x:Name="Cap20Toggle" Classes="seg small" Content="20" Tag="20" Click="OnAccurateCap" />
                    <ToggleButton x:Name="Cap30Toggle" Classes="seg small" Content="30" Tag="30" Click="OnAccurateCap" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="unit" Text="min" Margin="2,0,0,0" />
              </StackPanel>
              <ToggleButton x:Name="FocusBoxToggle" Classes="ghost small" Content="Fine box on the selected room" Click="OnFocusBox"
                            IsVisible="False" ToolTip.ShowOnDisabled="True"
                            ToolTip.Tip="High only: a 2:1 finer grid around one room, the room selected or isolated when you switch this on (the label names it). Isothermal passes only; a room that does not fit the graphics memory runs without the box and the pass line says so. Switch off and on again to move it to another room." />
            </StackPanel>
            <Border Classes="sep" />

            <!-- the view: what the particles show, and the cut -->
            <Border Classes="segment small">
              <StackPanel>
                <ToggleButton x:Name="SpeedModeToggle" Classes="seg small" Content="Speed" Click="OnSpeedMode"
                              ToolTip.Tip="Moving air, coloured by speed (legend on the right)." />
                <ToggleButton x:Name="StillModeToggle" Classes="seg small" Content="Still air" Click="OnStillMode"
                              ToolTip.Tip="V: a map of dead air. Every air cell slower than the threshold in the View tab is drawn as amber cloud, brighter the slower it is; moving air is left empty." />
              </StackPanel>
            </Border>
            <Border Classes="segment small">
              <StackPanel>
                <ToggleButton x:Name="SliceHToggle" Classes="seg small" Content="Plan" Click="OnSliceH"
                              ToolTip.Tip="S: a horizontal cut through the air at the height set in the View tab, like a floor plan coloured by the air." />
                <ToggleButton x:Name="SliceVToggle" Classes="seg small" Content="Section" Click="OnSliceV"
                              ToolTip.Tip="A vertical cut through the air along the line set in the View tab, like a building section coloured by the air." />
              </StackPanel>
            </Border>
            <StackPanel x:Name="ExpertViewTools" Orientation="Horizontal" Spacing="6">
              <ToggleButton x:Name="GhostToggle" Classes="ghost small" Content="Ghost" Click="OnGhostClick"
                            ToolTip.Tip="G: translucent walls. X cycles solid, ghost and X-ray." />
              <ToggleButton x:Name="ParticleToggle" Classes="ghost small" Content="Particles" Click="OnParticlesClick"
                            ToolTip.Tip="P: the moving particles." />
              <Border Classes="sep" />
              <ToggleButton x:Name="BoxToggle" Classes="ghost small" Content="Box" Click="OnBoxToggle"
                            ToolTip.Tip="Draw a fine box around an area to see its airflow in more detail; room numbers still come from the whole-building run." />
              <ToggleButton x:Name="ClipToggle" Classes="ghost small" Content="Clip" Click="OnClipToggle"
                            ToolTip.Tip="Clip the building and the slice to the box (a section box). Particles are not clipped." />
              <Button x:Name="BoxResetButton" Classes="ghost small" Content="Remove fine box" Click="OnBoxReset" IsVisible="False"
                      ToolTip.Tip="Removes the fine box; the whole building runs at the normal grid again." />
              <Button x:Name="BoxGrowButton" Classes="ghost small" Content="Fit box to openings" Click="OnBoxGrow" IsVisible="False"
                      ToolTip.Tip="Enlarges the fine box so no open window or device sits in its blended edge." />
            </StackPanel>
            <Border Classes="sep" />

            <!-- edits in the view: add an opening or a room by clicking, frame the selection. Both disabled while locked (UiTable). -->
            <Button x:Name="OpeningAddButton" Classes="ghost small" Content="+ Add opening" Click="OnOpeningAdd"
                    ToolTip.Tip="Click a wall in the 3D view to put a window there (1.2 x 1.2 m, sill 0.9 m). Wrongly detected? Use × on its row, Delete in the inspector, or the Delete key." />
            <Button x:Name="RoomAddButton" Classes="ghost small" Content="+ Add room" Click="OnRoomAdd"
                    ToolTip.Tip="Click inside a space in the 3D view to make it a room: the walled-in air at that point, found by the same detection the importer uses. Wrongly detected or not wanted? Use × on its row, Delete in the inspector, or the Delete key." />
            <Button Classes="ghost small" Content="Frame" Click="OnFrameSelection" ToolTip.Tip="F: put the camera on the selected room or opening (the whole building when nothing is selected)." />
            <!-- Room isolate: a view state, so it sits with the view tools and is visible in both modes. -->
            <Button x:Name="IsolateChip" Classes="ghost small isolate" Click="OnIsolateChip" IsVisible="False"
                    ToolTip.Tip="One room is shown on its own. View only: the simulation and the numbers are unchanged. Click, press Esc, or use Show all in the inspector to see every room again.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="IsolateChipText" Text="Isolated: —" VerticalAlignment="Center" />
                <app:Icon Classes="s" Data="{StaticResource IconX}" />
              </StackPanel>
            </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- speed legend: airspace rule keeps it out of the viewport -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding #Viewport3D.IsVisible}">
          <TextBlock x:Name="LegendTitle" Classes="label" Text="SPEED" />
          <TextBlock x:Name="LegendMin" Classes="unit" Text="0" />
          <StackPanel VerticalAlignment="Center">
            <Border x:Name="LegendBar" Width="150" Height="8" CornerRadius="4" />
            <!-- quarter ticks: a 4-column grid puts a 2-span centred label exactly on each column boundary -->
            <Grid x:Name="LegendTicks" Width="150" ColumnDefinitions="*,*,*,*" RowDefinitions="3,Auto" Margin="0,1,0,0">
              <Border Grid.ColumnSpan="2" Width="1" Height="3" HorizontalAlignment="Center" Background="{DynamicResource TextMuted}" />
              <Border Grid.Column="1" Grid.ColumnSpan="2" Width="1" Height="3" HorizontalAlignment="Center" Background="{DynamicResource TextMuted}" />
              <Border Grid.Column="2" Grid.ColumnSpan="2" Width="1" Height="3" HorizontalAlignment="Center" Background="{DynamicResource TextMuted}" />
              <TextBlock x:Name="LegendTick1" Grid.Row="1" Grid.ColumnSpan="2" Classes="unit" FontSize="9.5" HorizontalAlignment="Center" />
              <TextBlock x:Name="LegendTick2" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="unit" FontSize="9.5" HorizontalAlignment="Center" />
              <TextBlock x:Name="LegendTick3" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="unit" FontSize="9.5" HorizontalAlignment="Center" />
            </Grid>
          </StackPanel>
          <TextBlock x:Name="LegendMax" Classes="unit" Text="— m/s" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ viewport + side panel, side by side: no Avalonia content ever overlaps the child HWND ============ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <vp:ViewportHost x:Name="Viewport3D" Grid.Column="0" />

      <!-- Empty state: the native viewport is hidden until a model exists, so this is plain Avalonia. -->
      <StackPanel x:Name="EmptyState" Grid.Column="0" IsVisible="False" Spacing="14"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Center">
          <app:Icon Data="{StaticResource IconHouse}" Width="20" Height="20" Foreground="{DynamicResource TextMuted}" />
        </Border>
        <TextBlock Text="No building loaded" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                   Text="Open a model exported from Revit, or start with the sample house to see air move through rooms." />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Button x:Name="EmptySampleButton" Classes="tool accent" MinHeight="32" Content="Sample building" Click="OnSampleBuilding" />
          <Button Classes="secondary" Content="Open model…" Click="OnOpenModel" />
        </StackPanel>
        <Button x:Name="EmptyTourButton" Classes="link" Content="Take the tour" Click="OnTakeTour" HorizontalAlignment="Center"
                ToolTip.Tip="Twelve short steps that point out where things are." />
      </StackPanel>

      <Border x:Name="ResultsPanel" Grid.Column="1" Width="344" Background="{DynamicResource Panel}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}">
        <!-- tabs · import note · the list (scrolls) · the inspector (pinned) · the footer (pinned) -->
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

          <!-- The panel's tabs: Rooms, Openings, View in Basic; Devices and Studies in Expert (UiTable row ExpertTabs). Rooms on open. -->
          <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}">
            <StackPanel x:Name="SectionTabs" Orientation="Horizontal" Margin="6,0,0,0" Spacing="2">
              <ToggleButton x:Name="SectionRoomsTab" Classes="ptab" Content="Rooms" Tag="0" Click="OnSectionTab" ToolTip.Tip="The rooms and, after a run, each one's fresh air." />
              <ToggleButton x:Name="SectionOpeningsTab" Classes="ptab" Content="Openings" Tag="1" Click="OnSectionTab" ToolTip.Tip="Every window and door: open or close them, see the flow through each." />
              <ToggleButton x:Name="SectionViewTab" Classes="ptab" Content="View" Tag="2" Click="OnSectionTab" ToolTip.Tip="Still-air threshold, the cut, the environment." />
              <StackPanel x:Name="ExpertTabs" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="SectionDevicesTab" Classes="ptab" Content="Devices" Tag="3" Click="OnSectionTab" ToolTip.Tip="Fans, air conditioners, exhausts and diffusers in the run." />
                <ToggleButton x:Name="SectionStudiesTab" Classes="ptab" Content="Studies" Tag="4" Click="OnSectionTab" ToolTip.Tip="Compare A and B, best windows, annual." />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- what the import dropped or guessed: one line, whatever the section -->
          <TextBlock x:Name="ImportNoteText" Grid.Row="1" Classes="rowSub" TextWrapping="Wrap" IsVisible="False" Margin="14,10,12,0" Text="" />

          <ScrollViewer x:Name="PanelScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,12,14">

              <!-- ============ View: still air, the slice, the environment (Expert adds display and probes below) ============ -->
              <StackPanel x:Name="ResultsPane" Spacing="18">

                <!-- still air: only while the Still air view is on -->
                <StackPanel x:Name="StillSection" Spacing="7" IsVisible="False">
                  <TextBlock Classes="section" Text="STILL AIR" />
                  <Grid ColumnDefinitions="64,*,Auto">
                    <TextBlock Classes="unit" Text="slower than" VerticalAlignment="Center" />
                    <Slider x:Name="StillSlider" Grid.Column="1" Minimum="0.05" Maximum="0.5" Value="0.10"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            ValueChanged="OnStillThreshold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StillText" Grid.Column="2" Classes="unit" Text="0.10 m/s" VerticalAlignment="Center" />
                  </Grid>
                  <CheckBox x:Name="StillParticlesToggle" Content="Show moving air" FontSize="11" IsChecked="True"
                            Click="OnStillParticles"
                            ToolTip.Tip="Cyan lanes for the air that is moving faster than the threshold, over the amber dead air." />
                </StackPanel>


                <!-- slice: a cut through the air, in both modes. Basic sees speed only; the field choice and the
                     X/Y swap live in SliceExpertControls (a UiTable row). The title says what and where the cut is. -->
                <StackPanel x:Name="SliceSection" Spacing="7">
                  <TextBlock Classes="section" Text="SLICE" />
                  <!-- Plan / Section themselves sit on the viewport header; this section holds where the cut is and what it shows. -->
                  <!-- Expert: what colours the cut, and the section's axis. Its own row: the panel is 300 px wide. -->
                  <StackPanel x:Name="SliceExpertControls" Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="FieldSpeedToggle" Classes="tool small seg" Content="Speed" Click="OnFieldSpeed" Margin="0"
                                  ToolTip.Tip="Colour the cut by air speed, m/s." />
                    <ToggleButton x:Name="FieldPressureToggle" Classes="tool small seg" Content="Pressure" Click="OnFieldPressure"
                                  ToolTip.Tip="Colour the cut by pressure relative to the mean, Pa. Air moves from + to −." />
                    <ToggleButton x:Name="FieldTempToggle" Classes="tool small seg" Content="Temp" Click="OnFieldTemp"
                                  IsEnabled="False" ToolTip.Tip="Needs a thermal run." />
                    <Border Classes="sep" />
                    <Button Classes="tool small" Content="X/Y" Click="OnSliceAxis" ToolTip.Tip="Swap the vertical cut between the X and Y plane." />
                  </StackPanel>
                  <TextBlock x:Name="SliceTitle" Classes="rowName" Text="No cut shown" TextWrapping="Wrap" />
                  <Grid x:Name="SliceLegendRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" IsVisible="False">
                    <TextBlock x:Name="SliceLegendMin" Classes="unit" Text="0" VerticalAlignment="Center" />
                    <Border x:Name="SliceLegend" Grid.Column="1" Height="7" CornerRadius="3.5" Margin="6,0" />
                    <TextBlock x:Name="SliceLegendMax" Grid.Column="2" Classes="unit" Text="— m/s" VerticalAlignment="Center" />
                    <Grid x:Name="SliceTicks" Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*,*,*" RowDefinitions="3,Auto" Margin="6,1,6,0">
                      <Border Grid.ColumnSpan="2" Width="1" Height="3" HorizontalAlignment="Center" Background="{DynamicResource TextMuted}" />
                      <Border Grid.Column="1" Grid.ColumnSpan="2" Width="1" Height="3" HorizontalAlignment="Center" Background="{DynamicResource TextMuted}" />
                      <Border Grid.Column="2" Grid.ColumnSpan="2" Width="1" Height="3" HorizontalAlignment="Center" Background="{DynamicResource TextMuted}" />
                      <TextBlock x:Name="SliceTick1" Grid.Row="1" Grid.ColumnSpan="2" Classes="unit" FontSize="9.5" HorizontalAlignment="Center" />
                      <TextBlock x:Name="SliceTick2" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="unit" FontSize="9.5" HorizontalAlignment="Center" />
                      <TextBlock x:Name="SliceTick3" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="unit" FontSize="9.5" HorizontalAlignment="Center" />
                    </Grid>
                  </Grid>
                  <TextBlock x:Name="SliceHint" Classes="rowSub" TextWrapping="Wrap"
                             Text="Plan cuts the air horizontally at the height below; Section cuts it vertically along the line below. Colour is the air on that cut." />
                  <Grid ColumnDefinitions="40,*,Auto">
                    <TextBlock Classes="unit" Text="height" VerticalAlignment="Center" FontSize="10.5" />
                    <Slider x:Name="SliceZSlider" Grid.Column="1" Minimum="0" Maximum="6" Value="1.1"
                            ValueChanged="OnSliceZ" VerticalAlignment="Center" Margin="6,0,0,0"
                            ToolTip.Tip="Height of the plan cut above the ground." />
                    <TextBlock x:Name="SliceZText" Grid.Column="2" Classes="unit" Text="1.1 m" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="40,*,Auto">
                    <TextBlock Classes="unit" Text="cut line" VerticalAlignment="Center" FontSize="10.5" />
                    <Slider x:Name="SliceOtherSlider" Grid.Column="1" Minimum="0" Maximum="12" Value="6"
                            ValueChanged="OnSliceOther" VerticalAlignment="Center" Margin="6,0,0,0"
                            ToolTip.Tip="Where the section cuts the building." />
                    <TextBlock x:Name="SliceOtherText" Grid.Column="2" Classes="unit" Text="6.0 m" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <!-- environment: one row while thermal is off -->
                <StackPanel x:Name="EnvironmentSection" Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="ENVIRONMENT" />
                    <TextBlock x:Name="ThermalState" Grid.Column="1" Classes="unit" FontSize="10.5" Text="isothermal" />
                  </Grid>
                  <StackPanel x:Name="EnvironmentControls" Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="ThermalToggle" Classes="tool small" Content="Thermal (beta)" Click="OnThermal"
                                  ToolTip.Tip="Off: isothermal air. On: occupants (70 W each) and the indoor/outdoor difference drive buoyancy; the session restarts from rest and steps more slowly. Beta: the heat transport is checked against textbook cases (heated cavity, sealed-room energy balance) but not yet against measured rooms, so treat temperatures as indicative." />
                    <TextBlock Classes="unit" Text="in" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBox x:Name="IndoorBox" Classes="field" Width="40" Text="22" LostFocus="OnEnvironment"
                             KeyDown="OnEnvironmentKey" ToolTip.Tip="Indoor air temperature, °C: the start of a thermal run, and the set point each room is held at while 'Hold indoor temperature' is on. Free-running, nothing holds it: walls are adiabatic, so rooms drift toward outdoor air plus occupant gains. The Temp column shows the run's actual room mean." />
                    <TextBlock Classes="unit" Text="out" VerticalAlignment="Center" />
                    <TextBox x:Name="OutdoorBox" Classes="field" Width="40" Text="20" LostFocus="OnEnvironment"
                             KeyDown="OnEnvironmentKey" ToolTip.Tip="Outdoor air temperature, °C" />
                    <TextBlock Classes="unit" Text="°C" VerticalAlignment="Center" />
                  </StackPanel>
                  <CheckBox x:Name="HoldIndoorToggle" Click="OnHoldIndoor" IsChecked="True" IsVisible="False" FontSize="11"
                            Content="Hold indoor temperature (ideal heating/cooling)"
                            ToolTip.Tip="On: each room gets an ideal heater/cooler that holds its mean air temperature at the indoor value; the room rows and the report show the power it needs (W, + heating, - cooling). Off (free-running): the indoor value is only the starting temperature and rooms drift toward outdoor air plus gains. Walls are adiabatic (no U-values); only Surface heat sources exchange heat with the air. Changing it restarts a thermal run." />
                  <TextBlock x:Name="ThermalNote" Classes="rowSub" TextWrapping="Wrap" IsVisible="False" Text="" />
                </StackPanel>
              </StackPanel>

              <!-- ============ Rooms (the outliner) and Openings (the flat list): their own sections of the picker ============ -->
              <StackPanel x:Name="RoomsPane" Spacing="18" IsVisible="False">
                <StackPanel Spacing="6">
                  <!-- header: the result's state on the left, the question the dots answer on the right. Add room sits on the command bar. -->
                  <Grid ColumnDefinitions="*,Auto" MinHeight="26">
                    <Border x:Name="RoomsStateTag" Classes="chip" IsVisible="False" HorizontalAlignment="Left"
                            ToolTip.Tip="Preview numbers: a fast, coarse run, good for direction. They firm up when the averaged pass lands.">
                      <TextBlock x:Name="RoomsStateText" Text="preview" />
                    </Border>
                    <ToggleButton x:Name="AchIntentToggle" Grid.Column="1" Classes="link" Content="judged for air quality ▾"
                                  Click="OnAchIntent" />
                  </Grid>
                  <!-- One flat list: a room row, then (while expanded) its openings as child rows. The template is picked by type. -->
                  <ItemsControl x:Name="RoomList" Background="Transparent" PointerPressed="OnRoomListPress">
                    <ItemsControl.DataTemplates>
                      <DataTemplate x:DataType="app:RoomRow">
                        <Border Classes="row" Classes.selected="{Binding Selected}" PointerPressed="OnRoomRow"
                                Tag="{Binding Index}" ToolTip.Tip="{Binding Tip}" MinHeight="30" Padding="4,2,9,2">
                          <Grid ColumnDefinitions="22,*,20">
                            <!-- caret: expands the room to its openings; the row itself selects -->
                            <Button Classes="link caret" Content="{Binding Caret}" Tag="{Binding Index}" Click="OnRoomCaret"
                                    IsVisible="{Binding HasOpenings}" ToolTip.Tip="Show this room's openings" />
                            <!-- a Grid, not a StackPanel: a long name ("Revit: Master Bedroom, north-east") trims instead of
                                 running under the chips -->
                            <Grid Grid.Column="1" ColumnDefinitions="12,*,Auto,Auto" VerticalAlignment="Center">
                              <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                      HorizontalAlignment="Left" Background="{Binding Chip}" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="rowName" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !Renaming}"
                                         ToolTip.Tip="Click to show this room in 3D, click again or Esc to clear. Double-click to rename." />
                              <TextBox Grid.Column="1" Classes="field rename" Text="{Binding Name, Mode=OneWay}" IsVisible="{Binding Renaming}"
                                       Width="150" HorizontalAlignment="Left" AttachedToVisualTree="OnRenameAttached" KeyDown="OnRenameKey"
                                       LostFocus="OnRenameLost" ToolTip.Tip="Enter to keep, Esc to cancel." />
                              <Border Grid.Column="2" Classes="chip" Classes.warm="{Binding FlagWarm}" IsVisible="{Binding HasFlag}"
                                      ToolTip.Tip="{Binding FlagTip}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Flag}" />
                              </Border>
                              <Border Grid.Column="3" Classes="chip warm" IsVisible="{Binding Cut}" Margin="6,0,0,0"
                                      ToolTip.Tip="A simulation box face runs through this room: its air crosses an open boundary, so these numbers are not a building result.">
                                <TextBlock Text="cut" />
                              </Border>
                            </Grid>
                            <!-- ×: on the selected row, and on any row under the pointer (App.axaml Button.del) -->
                            <Button Grid.Column="2" Classes="link del" Classes.shown="{Binding Selected}" Content="×" Tag="{Binding Index}" Click="OnRoomDelete"
                                    Padding="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" ToolTip.Tip="Delete this room (undo in the status strip)" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                      <!-- a room's opening: switch, name, flow. Selecting it switches the inspector; the room stays expanded. -->
                      <DataTemplate x:DataType="app:OpeningRow">
                        <Border Classes="row child" Classes.selected="{Binding Selected}" PointerPressed="OnOpeningRow"
                                Tag="{Binding Index}" ToolTip.Tip="Click to show this opening in 3D. The switch opens or closes it.">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="switch" Classes.on="{Binding Open}" Classes.locked="{Binding Locked}" Width="22" Height="12"
                                    CornerRadius="6" Padding="2" VerticalAlignment="Center" Cursor="Hand"
                                    PointerPressed="OnOpeningSwitch" ToolTip.Tip="{Binding SwitchTip}">
                              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Chip}" HorizontalAlignment="{Binding Knob}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="rowName" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Flow}" Classes="rowValue" Classes.muted="{Binding !Open}" MinWidth="104"
                                       TextAlignment="Right" Margin="0" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.DataTemplates>
                  </ItemsControl>
                  <!-- Spaces without a room: the importer's detection, run once off the UI thread (MainWindowSpaces) -->
                  <StackPanel x:Name="SpacesBox" Spacing="2" IsVisible="False" Margin="0,8,0,0">
                    <TextBlock x:Name="SpacesHeader" Classes="colHead" TextAlignment="Left" Margin="9,0,0,0" Text="Spaces without a room"
                               ToolTip.Tip="Enclosed spaces the detection finds that are not a room. Click one to show it in 3D, Add to make it a room." />
                    <ItemsControl x:Name="SpaceList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:SpaceRow">
                          <Border Classes="row" Classes.selected="{Binding Selected}" PointerPressed="OnSpaceRow" Tag="{Binding Index}"
                                  MinHeight="30" Padding="9,2,4,2" ToolTip.Tip="Click to show this space in 3D. Add makes it a room.">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}" Classes="rowName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Button Grid.Column="1" Classes="tool small" Content="Add" Tag="{Binding Index}" Click="OnSpaceAdd"
                                      VerticalAlignment="Center" ToolTip.Tip="Make this space a room (undo in the status strip)" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock x:Name="RoomsNote" Classes="rowSub" TextWrapping="Wrap" Text="Run to see each room's fresh air." />
                  <TextBlock Classes="rowSub" Text="Click a room to see it in 3D · double-click to rename · Ctrl+click two rooms to merge them" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="OpeningsPane" Spacing="18" IsVisible="False">
                <StackPanel Spacing="6">
                  <!-- header: the result's state. Add opening sits on the command bar. -->
                  <Grid ColumnDefinitions="*,Auto" MinHeight="26">
                    <Border x:Name="OpeningsStateTag" Classes="chip" IsVisible="False" HorizontalAlignment="Left"
                            ToolTip.Tip="Preview numbers: a fast, coarse run, good for direction. They firm up when the averaged pass lands.">
                      <TextBlock x:Name="OpeningsStateText" Text="preview" />
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="9,0,9,0">
                    <TextBlock Classes="colHead" Text="OPENING" TextAlignment="Left" Margin="30,0,0,0" />
                    <TextBlock Grid.Column="1" Classes="colHead" Text="flow" Margin="0,0,20,0"
                               ToolTip.Tip="Volume of air through the opening, cubic metres per second; the arrow says which way." />
                  </Grid>
                  <!-- one line per opening; type, Cd and size live in the inspector below -->
                  <ItemsControl x:Name="OpeningListView">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:OpeningRow">
                        <Border Classes="row" Classes.selected="{Binding Selected}" PointerPressed="OnOpeningRow"
                                Tag="{Binding Index}" MinHeight="30" Padding="9,2,4,2"
                                ToolTip.Tip="Click to show this opening in 3D, click again or Esc to clear. The switch opens or closes it.">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto,20">
                            <CheckBox IsChecked="{Binding Pick, Mode=OneWay}" IsVisible="{Binding Sweepable}"
                                      Tag="{Binding Index}" Click="OnOpeningPick" MinWidth="0" Margin="0,0,2,0"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Include this opening in the Best windows sweep (up to 8)." />
                            <Border Grid.Column="1" Classes="switch" Classes.on="{Binding Open}"
                                    Classes.locked="{Binding Locked}" Width="22" Height="12"
                                    CornerRadius="6" Padding="2" VerticalAlignment="Center" Cursor="Hand"
                                    PointerPressed="OnOpeningSwitch" ToolTip.Tip="{Binding SwitchTip}">
                              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Chip}"
                                      HorizontalAlignment="{Binding Knob}" />
                            </Border>
                            <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto" Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" Classes="rowName" VerticalAlignment="Center" />
                              <Border Grid.Column="1" Classes="chip warm" IsVisible="{Binding Cut}" Margin="6,0,0,0"
                                      ToolTip.Tip="This opening serves a room a simulation box face cuts through, so its flow is not a building result.">
                                <TextBlock Text="cut" />
                              </Border>
                              <Border Grid.Column="2" Classes="chip" IsVisible="{Binding Blend}" ToolTip.Tip="{Binding BlendTip}" Margin="6,0,0,0">
                                <TextBlock Text="in blend band" />
                              </Border>
                            </Grid>
                            <TextBlock Grid.Column="3" Text="{Binding Flow}" Classes="rowValue" Classes.muted="{Binding !Open}" />
                            <!-- ×: on the selected row, and on any row under the pointer (App.axaml Button.del) -->
                            <Button Grid.Column="4" Classes="link del" Classes.shown="{Binding Selected}" Content="×" Tag="{Binding Index}" Click="OnOpeningDelete"
                                    Padding="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" ToolTip.Tip="Delete this opening (undo in the status strip)" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- deleted openings, while Add opening is armed (RefreshDeletedRows): Restore brings the original back -->
                  <StackPanel x:Name="DeletedBox" Spacing="2" IsVisible="False" Margin="0,8,0,0">
                    <ItemsControl x:Name="DeletedList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:DeletedRow">
                          <Border Classes="row" MinHeight="30" Padding="9,2,4,2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Label}" Classes="rowName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Button Grid.Column="1" Classes="tool small" Content="Restore" Tag="{Binding Index}" Click="OnRestoreDeleted"
                                      VerticalAlignment="Center" ToolTip.Tip="Bring the deleted opening back, at its original size, type and Cd" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock x:Name="OpeningsNote" Classes="rowSub" TextWrapping="Wrap"
                             Text="The switch opens or closes it; the arrow says which way the air goes. Click a window in the view to do the same." />
                </StackPanel>
              </StackPanel>

              <!-- ============ Expert only: Devices, View, Studies ============ -->
              <StackPanel x:Name="ExpertPanes">

                <!-- devices -->
                <StackPanel x:Name="DevicesPane" Spacing="7" IsVisible="False">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Classes="section" Text="DEVICES" VerticalAlignment="Center" />
                    <TextBlock x:Name="DevicesNote" Grid.Column="1" Classes="unit" FontSize="10.5" Text=""
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                  </Grid>
                  <!-- the palette: one click on a tile, one click in the viewport. Tiles are built in InitDevices. -->
                  <UniformGrid x:Name="DevicePalette" Columns="4" />
                  <TextBlock x:Name="DevicesHint" Classes="rowSub" TextWrapping="Wrap" Text=""
                             Foreground="{DynamicResource Warning}" IsVisible="False" />
                  <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:DeviceRow">
                        <Border Classes="row" PointerPressed="OnDeviceRow" Tag="{Binding Index}"
                                ToolTip.Tip="{Binding Tip}">
                          <Grid ColumnDefinitions="10,*,64" RowDefinitions="Auto,Auto,Auto">
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{Binding Chip}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                              <TextBlock Text="{Binding Name}" Classes="rowName" VerticalAlignment="Center" />
                              <Border Classes="chip" IsVisible="{Binding Off}">
                                <TextBlock Text="off" />
                              </Border>
                              <Border Classes="chip" Classes.warm="{Binding Refine}" ToolTip.Tip="{Binding ResWhy}"
                                      Classes.action="{Binding Boxable}" PointerPressed="OnRefineChip">
                                <TextBlock Text="{Binding ResLabel}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="rowValue" Margin="0"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Sub}"
                                       Classes="rowSub" TextWrapping="Wrap" Margin="4,1,0,0" />

                            <!-- inline inspector, only on the selected row: actions first, the numbers behind Details -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4"
                                        Margin="4,5,0,1" IsVisible="{Binding Editing}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="tool small" Content="{Binding ToggleLabel}" Tag="{Binding Index}"
                                        Click="OnDeviceToggle" />
                                <Button Classes="tool small" Content="Remove" Tag="{Binding Index}" Click="OnDeviceRemove" />
                                <Button Classes="tool small" Content="{Binding DetailsLabel}" Tag="{Binding Index}"
                                        Click="OnDeviceDetails"
                                        ToolTip.Tip="Flow, size, swirl, supply temperature, louvre and heading." />
                              </StackPanel>
                              <StackPanel Spacing="4" IsVisible="{Binding ShowDetails}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="flow" Classes="rowSub" VerticalAlignment="Center" Width="30" />
                                <TextBox Classes="field" Width="44" Padding="3,1" FontSize="11" Tag="flow"
                                         Text="{Binding Flow, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="m³/s" Classes="rowSub" VerticalAlignment="Center" />
                                <TextBlock Text="radius" Classes="rowSub" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBox Classes="field" Width="40" Padding="3,1" FontSize="11" Tag="radius"
                                         Text="{Binding Radius, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="m" Classes="rowSub" VerticalAlignment="Center" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="swirl" Classes="rowSub" VerticalAlignment="Center" Width="30" />
                                <TextBox Classes="field" Width="44" Padding="3,1" FontSize="11" Tag="swirl"
                                         Text="{Binding Swirl, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="supply" Classes="rowSub" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBox Classes="field" Width="40" Padding="3,1" FontSize="11" Tag="supply"
                                         Text="{Binding Supply, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="°C" Classes="rowSub" VerticalAlignment="Center" />
                              </StackPanel>
                              <!-- High Accuracy only, and only for link-wise supply patches (Revit air terminals): the inlet turbulence of this supply. Blank = the preset's default. -->
                              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding TurbVisible}"
                                          ToolTip.Tip="Supply turbulence intensity, % of the face velocity, used only by the High (gusty wind) pass (Standard and Preview run smooth inlets) and only for Revit air terminals (duct supply patches); fans, split AC, cassette and diffuser devices ignore it. Blank or — keeps the preset's default. Typical diffusers 10-30 %.">
                                <TextBlock Text="turb" Classes="rowSub" VerticalAlignment="Center" Width="30" />
                                <TextBox Classes="field" Width="44" Padding="3,1" FontSize="11" Tag="turb"
                                         Text="{Binding Turb, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="% supply turbulence · High only" Classes="rowSub" VerticalAlignment="Center" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="louvre" Classes="rowSub" VerticalAlignment="Center" Width="30" />
                                <TextBox Classes="field" Width="44" Padding="3,1" FontSize="11" Tag="louvre"
                                         Text="{Binding Louvre, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="°" Classes="rowSub" VerticalAlignment="Center" />
                                <TextBlock Text="yaw" Classes="rowSub" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBox Classes="field" Width="40" Padding="3,1" FontSize="11" Tag="yaw"
                                         Text="{Binding Yaw, Mode=OneWay}" LostFocus="OnDeviceField" KeyDown="OnDeviceFieldKey" />
                                <TextBlock Text="°" Classes="rowSub" VerticalAlignment="Center" />
                              </StackPanel>
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="DevicesEmpty" Classes="rowSub" TextWrapping="Wrap"
                             Text="No devices in this model. Pick one above, then click where it goes." />
                </StackPanel>

                <!-- view: walls, particles, slice, probe -->
                <StackPanel x:Name="ViewPane" Spacing="18" IsVisible="False">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="DISPLAY" />
                    <Grid ColumnDefinitions="64,*,Auto">
                      <TextBlock Classes="unit" Text="playback" VerticalAlignment="Center" />
                      <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="2" Maximum="32" Value="16"
                              VerticalAlignment="Center" ValueChanged="OnSpeedChanged"
                              ToolTip.Tip="How fast the particles are played back. Visual only: it does not change the solve." />
                      <TextBlock x:Name="SpeedSliderText" Grid.Column="2" Classes="unit" Text="16×" Width="30"
                                 TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="section" Text="PROBE" VerticalAlignment="Center" />
                      <ToggleButton x:Name="ProbeToggle" Grid.Column="1" Classes="tool small" Content="Place"
                                    Click="OnProbeToggle" Margin="0,0,6,0" />
                      <Button Grid.Column="2" Classes="tool small" Content="Clear" Click="OnProbeClear" />
                    </Grid>
                    <ItemsControl x:Name="ProbeList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:ProbeRow">
                          <Border Classes="row">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" Classes="rowName" />
                              <TextBlock Text="{Binding Sub}" Classes="rowSub" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProbeHint" Classes="rowSub" Text="B, then click the slice or a floor." />
                  </StackPanel>
                </StackPanel>

                <!-- studies: compare, best windows, annual -->
                <StackPanel x:Name="StudiesPane" Spacing="20" IsVisible="False">

                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="section" Text="COMPARE" />
                      <TextBlock x:Name="CompareState" Grid.Column="1" Classes="unit" FontSize="10.5" Text="" />
                    </Grid>
                    <StackPanel x:Name="CompareActions" Orientation="Horizontal" Spacing="6">
                      <Button x:Name="HoldAButton" Classes="tool small" Content="Hold A" Click="OnHoldA"
                              ToolTip.Tip="Freeze the live state as a finished result. The solver pauses for one burst while it averages." />
                      <Button x:Name="HoldBButton" Classes="tool small" Content="Hold B" Click="OnHoldB"
                              ToolTip.Tip="Change something (a window, the wind), let it settle, then hold B and compare." />
                      <ToggleButton x:Name="CompareToggle" Classes="tool small" Content="Compare" Click="OnCompare"
                                    ToolTip.Tip="Show B minus A: the slice turns into a difference map and the table below reads per-room deltas." />
                    </StackPanel>
                    <TextBlock x:Name="CompareNote" Classes="rowSub" TextWrapping="Wrap"
                               Text="Hold A, change something, hold B, then Compare." />
                    <Grid x:Name="CompareHead" ColumnDefinitions="*,50,50,54" Margin="9,2,9,0" IsVisible="False">
                      <TextBlock Classes="colHead" Text="ROOM" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Classes="colHead" Text="A fresh ACH" />
                      <TextBlock Grid.Column="2" Classes="colHead" Text="B fresh ACH" />
                      <TextBlock Grid.Column="3" Classes="colHead" Text="Δ fresh ACH" />
                    </Grid>
                    <ItemsControl x:Name="CompareList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:CompareRow">
                          <Border Classes="row" Cursor="Arrow">
                            <Grid ColumnDefinitions="*,50,50,54">
                              <TextBlock Text="{Binding Name}" Classes="rowName" />
                              <TextBlock Grid.Column="1" Text="{Binding A}" Classes="rowValue muted" TextAlignment="Right" />
                              <TextBlock Grid.Column="2" Text="{Binding B}" Classes="rowValue muted" TextAlignment="Right" />
                              <TextBlock Grid.Column="3" Text="{Binding Delta}" Classes="rowValue" TextAlignment="Right"
                                         Foreground="{Binding DeltaBrush}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="section" Text="BEST WINDOWS" />
                      <TextBlock x:Name="SweepNote" Grid.Column="1" Classes="unit" FontSize="10.5" Text="" />
                    </Grid>
                    <StackPanel x:Name="SweepActions" Spacing="7">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="unit" Text="rank by" VerticalAlignment="Center" />
                        <ToggleButton x:Name="RankOverallToggle" Classes="tool small seg" Content="Overall" Click="OnRankOverall"
                                      IsChecked="True" Margin="0" ToolTip.Tip="Core ranks first by sealed indoor volume (less is better), then by the whole-building fresh-air rate: 3600 / the mean air age over the indoor volume, with any sealed room left out and named in the results." />
                        <ToggleButton x:Name="RankRoomToggle" Classes="tool small seg" Content="Room" Click="OnRankRoom"
                                      ToolTip.Tip="Re-sort the same runs by the fresh-air ACH of the selected room (3600 / its mean air age, solved for every combination)." />
                      </StackPanel>
                      <TextBlock x:Name="RankNote" Classes="rowSub"
                                 Text="Ranked by sealed volume first (less is better), then by the building's fresh-air rate (3600 / mean air age; sealed rooms are left out and named)." />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SweepButton" Classes="tool small" Content="Sweep" Click="OnSweep" />
                        <Button x:Name="SweepCancelButton" Classes="tool small" Content="Cancel" Click="OnJobCancel"
                                IsVisible="False" />
                        <ProgressBar x:Name="SweepProgress" Width="86" Height="3" IsVisible="False" Minimum="0" Maximum="100"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="SweepHint" Classes="rowSub" TextWrapping="Wrap"
                               Text="Tick up to 8 openings on the Results tab, then Sweep." />
                    <ItemsControl x:Name="SweepList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:SweepRow">
                          <Border Classes="row" PointerPressed="OnSweepRow" Tag="{Binding Index}" ToolTip.Tip="{Binding Tip}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <TextBlock Text="{Binding Chips}" FontSize="12.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="{Binding Name}" Classes="rowName" />
                                <TextBlock Text="{Binding Sub}" Classes="rowSub" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Ach}" Classes="rowValue" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="7">
                    <TextBlock Classes="section" Text="ANNUAL" />
                    <StackPanel x:Name="AnnualActions" Orientation="Horizontal" Spacing="6">
                      <Button Classes="tool small" Content="Load EPW..." Click="OnLoadEpw" />
                      <Button x:Name="AnnualButton" Classes="tool small" Content="Run annual" Click="OnRunAnnual"
                              IsEnabled="False" ToolTip.Tip="One Preview run per wind bin (16 sectors x 4 speed bands at most)." />
                      <Button x:Name="AnnualCancelButton" Classes="tool small" Content="Cancel" Click="OnJobCancel"
                              IsVisible="False" />
                    </StackPanel>
                    <TextBlock x:Name="EpwText" Classes="rowSub" TextWrapping="Wrap" Text="No weather file loaded." />
                    <Canvas x:Name="RoseCanvas" Width="132" Height="132" IsVisible="False" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="AnnualProgress" Height="3" IsVisible="False" Minimum="0" Maximum="100"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" />
                    <ItemsControl x:Name="AnnualList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:AnnualRow">
                          <Border Classes="row">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" Classes="rowName" />
                                <TextBlock Text="{Binding Sub}" Classes="rowSub" TextWrapping="Wrap" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Share}" Classes="rowValue" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- The inspector (a properties editor): pinned under the list, follows the one selection whatever the section shows. -->
          <Border x:Name="Inspector" Grid.Row="3" Classes="inspector" MaxHeight="300">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="InspectorEmpty" Classes="rowSub" TextWrapping="Wrap"
                           Text="Select a room or an opening in the list, or click one in the view." />

                <!-- room -->
                <StackPanel x:Name="RoomInspector" Spacing="8" IsVisible="False">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource SelectedStroke}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RoomInspTitle" Classes="rowName" FontSize="13" FontWeight="SemiBold" Text="" />
                      </StackPanel>
                      <TextBlock x:Name="RoomInspSub" Classes="rowSub" Text="" />
                    </StackPanel>
                    <ToggleButton x:Name="InspIsolateButton" Grid.Column="1" Classes="ghost small" Content="Isolate" Click="OnIsolateRow" Margin="0,0,6,0"
                                  ToolTip.Tip="Show only this room: the others disappear and the air in this one keeps moving exactly as before. View only, nothing is recomputed. Esc or the chip on the viewport header shows all rooms again." />
                    <Button x:Name="InspFrameButton" Grid.Column="2" Classes="ghost small" Content="Frame" Click="OnFrameSelection" Margin="0,0,6,0"
                            ToolTip.Tip="F: put the camera on this room." />
                    <Button x:Name="RoomInspDeleteButton" Grid.Column="3" Classes="ghost small danger" Content="Delete" Click="OnRoomDelete"
                            ToolTip.Tip="Delete this room: it stops being reported and its air becomes unassigned indoor air; its openings stay. Undo in the status strip until the next edit." />
                  </Grid>
                  <!-- three figures: the list's two scan columns plus the air age, with units -->
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Border Classes="row figure">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock x:Name="RoomInspAch" Classes="figure" Text="—" />
                          <TextBlock x:Name="RoomInspAchNote" Classes="figureUnit" Text="" />
                        </StackPanel>
                        <TextBlock Classes="colHead" Text="FRESH-AIR ACH" TextAlignment="Left" LetterSpacing="0.5" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="row figure">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock x:Name="RoomInspStill" Classes="figure" Text="—" />
                          <TextBlock Classes="figureUnit" Text="%" />
                        </StackPanel>
                        <TextBlock Classes="colHead" Text="STILL" TextAlignment="Left" LetterSpacing="0.5" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="row figure">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock x:Name="RoomInspAge" Classes="figure" Text="—" />
                          <TextBlock x:Name="RoomInspAgeUnit" Classes="figureUnit" Text="" />
                        </StackPanel>
                        <TextBlock Classes="colHead" Text="AIR AGE" TextAlignment="Left" LetterSpacing="0.5" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Classes="rowSub" Text="Air speed" VerticalAlignment="Top" />
                    <TextBlock x:Name="RoomInspSpeed" Grid.Column="1" Classes="rowName" Text="—" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Classes="rowSub" Text="Verdict" VerticalAlignment="Top" />
                    <TextBlock x:Name="RoomInspVerdict" Grid.Row="1" Grid.Column="1" Classes="rowName" Text="—" TextWrapping="Wrap" />
                  </Grid>
                  <!-- Expert: the total exchange, the people in the room, and Add opening from here -->
                  <StackPanel x:Name="RoomInspectorExpert" Spacing="6">
                    <TextBlock x:Name="RoomInspDetail" Classes="rowSub" TextWrapping="Wrap" Text="" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="people" Classes="rowSub" VerticalAlignment="Center" />
                      <TextBox x:Name="RoomInspPeople" Classes="field" Width="40" Padding="3,1" FontSize="11"
                               LostFocus="OnOccupants" KeyDown="OnOccupantsKey"
                               ToolTip.Tip="People in this room. With Thermal on, Core turns each into 70 W of sensible heat; editing restarts the solve." />
                      <Button Classes="link" Content="Add opening to this room…" Click="OnOpeningAdd" Margin="10,0,0,0"
                              ToolTip.Tip="Click one of this room's walls in the 3D view to put a window there." />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <!-- two or more rooms (Ctrl+click) -->
                <StackPanel x:Name="MergeInspector" Spacing="8" IsVisible="False">
                  <TextBlock x:Name="MergeTitle" Classes="rowName" FontSize="13" FontWeight="SemiBold" Text="" />
                  <TextBlock x:Name="MergeSub" Classes="rowSub" TextWrapping="Wrap" Text="" />
                  <Button x:Name="MergeButton" Classes="tool small" Content="Merge rooms" Click="OnRoomMerge" HorizontalAlignment="Left"
                          ToolTip.ShowOnDisabled="True" />
                </StackPanel>

                <!-- opening -->
                <StackPanel x:Name="OpeningInspector" Spacing="8" IsVisible="False">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource SelectedStroke}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpeningInspTitle" Classes="rowName" FontSize="13" FontWeight="SemiBold" Text="" />
                      </StackPanel>
                      <TextBlock x:Name="OpeningInspSub" Classes="rowSub" Text="" />
                    </StackPanel>
                    <Button x:Name="InspOpeningFrameButton" Grid.Column="1" Classes="ghost small" Content="Frame" Click="OnFrameSelection" Margin="0,0,6,0"
                            ToolTip.Tip="F: put the camera on this opening." />
                    <Button x:Name="InspDeleteButton" Grid.Column="2" Classes="ghost small danger" Content="Delete" Click="OnOpeningDelete"
                            ToolTip.Tip="Delete this opening: its hole acts as wall. Undo in the status strip until the next edit." />
                  </Grid>
                  <!-- size: editable for a hand-added opening, read-only for a detected one (disabled while locked, UiTable) -->
                  <StackPanel x:Name="OpeningInspectorEdit" Spacing="8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="colHead" Text="WIDTH" TextAlignment="Left" />
                        <Grid>
                          <TextBox x:Name="InspWidth" GotFocus="OnInspBoxFocus" Classes="field" Tag="Width" HorizontalContentAlignment="Left" Padding="8,4,20,4"
                                   LostFocus="OnOpeningDimBox" KeyDown="OnOpeningDimKey" ToolTip.Tip="Width in metres (0.2 to 6). Enter or click away applies." />
                          <TextBlock Classes="unit" Text="m" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="colHead" Text="HEIGHT" TextAlignment="Left" />
                        <Grid>
                          <TextBox x:Name="InspHeight" GotFocus="OnInspBoxFocus" Classes="field" Tag="Height" HorizontalContentAlignment="Left" Padding="8,4,20,4"
                                   LostFocus="OnOpeningDimBox" KeyDown="OnOpeningDimKey" ToolTip.Tip="Height in metres (0.2 to 6); the sill stays." />
                          <TextBlock Classes="unit" Text="m" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Classes="colHead" Text="SILL" TextAlignment="Left" />
                        <Grid>
                          <TextBox x:Name="InspSill" GotFocus="OnInspBoxFocus" Classes="field" Tag="Sill" HorizontalContentAlignment="Left" Padding="8,4,20,4"
                                   LostFocus="OnOpeningDimBox" KeyDown="OnOpeningDimKey" ToolTip.Tip="Sill height above the floor, metres (0 to 3)." />
                          <TextBlock Classes="unit" Text="m" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Classes="rowSub" Text="Type" VerticalAlignment="Center" />
                      <ComboBox x:Name="InspType" Grid.Column="1" Classes="picker" FontWeight="Normal" FontSize="12" MinHeight="28" Padding="10,3"
                                HorizontalAlignment="Stretch" SelectionChanged="OnOpeningType" ToolTip.Tip="Window or door (hand-added openings only).">
                        <ComboBoxItem Content="Window" />
                        <ComboBoxItem Content="Door" />
                      </ComboBox>
                      <TextBlock Grid.Row="1" Classes="rowSub" Text="State" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border x:Name="InspSwitch" Classes="switch" Width="22" Height="12" CornerRadius="6" Padding="2" VerticalAlignment="Center" Cursor="Hand"
                                PointerPressed="OnOpeningSwitch" ToolTip.Tip="Open or close this opening.">
                          <Border x:Name="InspKnob" Width="8" Height="8" CornerRadius="4" />
                        </Border>
                        <TextBlock x:Name="OpeningInspState" Classes="rowName" Text="" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                    <!-- Expert, window or door: the discharge coefficient the calibrated opening model aims for -->
                    <StackPanel x:Name="OpeningInspectorExpert" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Cd" Classes="rowSub" VerticalAlignment="Center" Width="58" />
                      <TextBox x:Name="InspCd" GotFocus="OnInspBoxFocus" Classes="field" Width="52" Padding="3,1" FontSize="11" LostFocus="OnCdBox" KeyDown="OnCdKey"
                               ToolTip.Tip="Discharge coefficient of this opening, 0.05 to 1. Editing restarts the solve (and cancels an averaged pass)." />
                      <TextBlock x:Name="InspCdName" Classes="rowSub" VerticalAlignment="Center" Text="" />
                      <Button Classes="link" Content="presets ▾" Click="OnCdPresets" Padding="2,0"
                              ToolTip.Tip="Typical discharge coefficients. Only the sharp-edged 0.61 is the solver's own default; the others are typical values, not measured here." />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- the footer: which result the numbers are, how far the averaged pass has got, and the trust line (both modes) -->
          <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Padding="14,10,12,12">
            <StackPanel Spacing="6">
              <TextBlock x:Name="AccurateModeNote" Classes="rowSub" TextWrapping="Wrap" IsVisible="False"
                         Text="Standard: steady wind, up to 10 min. High (gusty wind): gusts and supply turbulence; numbers vary, shown with ranges." />
              <!-- Preview, then Accurate: which result the numbers are, and how far the Accurate pass has got -->
              <StackPanel x:Name="PassPanel" Spacing="6" IsVisible="False" Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*">
                  <Border x:Name="PassTag" Classes="chip pass">
                    <TextBlock x:Name="PassTagText" Text="PREVIEW" />
                  </Border>
                  <TextBlock x:Name="PassText" Grid.Column="1" Classes="rowSub" Margin="8,0,0,0" VerticalAlignment="Center"
                             TextWrapping="Wrap" Text="" />
                </Grid>
                <Border x:Name="PassTrack" Height="3" CornerRadius="1.5" Background="{DynamicResource Track}" ClipToBounds="True">
                  <Border x:Name="PassFill" Classes="passFill" CornerRadius="1.5"
                          RenderTransformOrigin="0%,50%" RenderTransform="scaleX(0)">
                    <Border.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.9" Easing="CubicEaseOut" />
                      </Transitions>
                    </Border.Transitions>
                  </Border>
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border x:Name="TrustChip" Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center"
                        Background="{DynamicResource TextMuted}" />
                <TextBlock x:Name="TrustHead" Grid.Column="1" Classes="rowName" Margin="9,0,0,0" Text="Not solved yet"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="NotesToggle" Grid.Column="2" Classes="link" Content="" IsVisible="False"
                              Click="OnNotes" ToolTip.Tip="What the solver wants you to know about this result." />
              </Grid>
              <TextBlock x:Name="TrustDetail" Classes="rowSub" TextWrapping="Wrap" Text="" />
              <ScrollViewer x:Name="NotesScroll" MaxHeight="210" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="NotesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid ColumnDefinitions="14,*" Margin="0,2,0,3">
                        <Border Width="4" Height="4" CornerRadius="2" Background="{DynamicResource WarmFg}" VerticalAlignment="Top"
                                Margin="1,6,0,0" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding}" Classes="rowSub" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- settings popover, both modes: its own top-level window, so it can float over the 3D view -->
    <Popup x:Name="SettingsPopup" Grid.Row="2" PlacementTarget="{Binding #GearButton}"
           Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True" VerticalOffset="6">
      <Border x:Name="SettingsCard" Classes="card" Width="320" Padding="16,14,16,16">
        <StackPanel Spacing="9">
          <TextBlock Classes="section" Text="SETTINGS" />

          <!-- Dark (default) or Light chrome; the 3D view stays dark in both -->
          <Grid ColumnDefinitions="88,Auto" ToolTip.Tip="Dark or light panels around the same dark 3D view. Remembered.">
            <TextBlock Classes="unit" Text="Appearance" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="segment small">
              <StackPanel>
                <ToggleButton x:Name="ThemeDarkToggle" Classes="seg small" Tag="Dark" Click="OnTheme" IsChecked="True">
                  <StackPanel Orientation="Horizontal" Spacing="6"><app:Icon Classes="s" Data="{StaticResource IconMoon}" /><TextBlock Text="Dark" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ThemeLightToggle" Classes="seg small" Tag="Light" Click="OnTheme">
                  <StackPanel Orientation="Horizontal" Spacing="6"><app:Icon Classes="s" Data="{StaticResource IconSun}" /><TextBlock Text="Light" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="88,*,Auto" ToolTip.Tip="How much of the GPU the solver may keep busy. Lower is slower but leaves the computer usable; the solver sleeps between short bursts to hold this share, and the viewport drops to 30 fps while solving (5 fps when WindFlow is in the background).">
            <TextBlock Classes="unit" Text="GPU use" VerticalAlignment="Center" />
            <Slider x:Name="GpuSlider" Grid.Column="1" Minimum="25" Maximum="100" Value="60"
                    TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnGpuUse" VerticalAlignment="Center" />
            <TextBlock x:Name="GpuText" Grid.Column="2" Classes="unit" Text="60 %" Width="38" TextAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
          <TextBlock x:Name="GpuNote" Classes="rowSub" TextWrapping="Wrap" Text="applies while solving" Margin="88,-6,0,0" />

          <Grid x:Name="TierRow" ColumnDefinitions="88,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="unit" Text="Performance" VerticalAlignment="Center" />
            <TextBlock x:Name="TierText" Grid.Column="1" Classes="rowName" FontSize="12" Text="measuring…"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="TierNote" Grid.Row="1" Grid.Column="1" Classes="rowSub" TextWrapping="Wrap"
                       Text="a two-second solver run picks the grid and particle budget" />
          </Grid>

          <Grid ColumnDefinitions="88,Auto,Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="unit" Text="Particles" VerticalAlignment="Center" />
            <TextBox x:Name="ParticleBox" Grid.Column="1" Classes="field" Width="76" Text="Auto"
                     KeyDown="OnParticleKey" LostFocus="OnParticleLost"
                     ToolTip.Tip="Auto follows the frame rate (up to 100k, more while a result is locked). Type a number to fix the count; clear the box or press Auto to go back." />
            <Button x:Name="ParticleAutoButton" Grid.Column="2" Classes="tool small" Content="Auto" Margin="6,0,0,0"
                    Click="OnParticleAuto" />
            <TextBlock x:Name="ParticleLimitText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="rowSub"
                       TextWrapping="Wrap" Text="your GPU: measuring…" />
          </Grid>

          <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto"
                ToolTip.Tip="The finer whole-building grid the averaged pass runs on once Preview has settled. Auto takes it from the performance tier; it is always clamped to what the graphics card's memory holds next to the Preview grid.">
            <TextBlock Classes="unit" Text="Averaged grid" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="AccurateText" Grid.Column="1" Classes="rowName" FontSize="12" Text="auto · measuring…"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="AccurateEditRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,5,0,0">
              <TextBox x:Name="AccurateBox" Classes="field" Width="76" Text="Auto"
                       KeyDown="OnAccurateKey" LostFocus="OnAccurateLost"
                       ToolTip.Tip="Cells for the averaged pass, e.g. 4M or 2500k. Empty or Auto follows the performance tier. Applies to the next averaged pass." />
              <TextBlock x:Name="AccurateNote" Classes="rowSub" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="140" Text="" />
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{DynamicResource Divider}" Margin="0,2" />
          <StackPanel x:Name="BoxV1Row">
            <CheckBox x:Name="BoxV1Toggle" Click="OnBoxV1" Content="Box is the whole domain (v1)"
                      ToolTip.Tip="Off (default): the simulation box is a fine grid at half the cell size, fed by the whole-building run, so its faces carry the real building flow. On: the old v1 box, solved on its own with open faces, which misreads any face that cuts through the building. For comparison only." />
          </StackPanel>
          <StackPanel x:Name="OpeningModelRow">
            <ToggleButton x:Name="OpeningModelToggle" Classes="tool small" Content="Opening model: Calibrated" Click="OnOpeningModel"
                          HorizontalAlignment="Left"
                          ToolTip.Tip="Calibrated (default): a sub-grid loss makes an isolated window or door discharge at its Cd (0.61 unless set on the row), because the grid is too coarse to resolve the opening; in the building the effective value also depends on the flow around it. Resolved: the opening is left as carved cells and whatever the grid gives. Restarts the solve." />
          </StackPanel>
          <StackPanel x:Name="WallModelRow">
            <CheckBox x:Name="WallModelToggle" Click="OnWallModel" Content="Wall model (experimental, wind-only)"
                      ToolTip.Tip="Off (default): plain no-slip walls. On: a Werner-Wengle wall function sets the near-wall velocity on every solid face, which the coarse grid cannot resolve on its own. Experimental and isothermal only: greyed out while Thermal is on. On the measured test rooms it gave mixed results that change with the grid. Restarts the solve." />
          </StackPanel>
          <StackPanel x:Name="DomainModeRow">
            <CheckBox x:Name="DomainModeToggle" Click="OnDomainMode" Content="Full wind domain (COST 732)"
                      ToolTip.Tip="Off (default): the compact wind domain, margins tied to the plan size; the building then blocks about 10 % of the wind section, above the 3 % guideline. On: margins of 5 building heights upwind, sideways and above and 10 downwind, enlarged until the blockage is at most 3 %, at the same cell size, so many more cells. Cut back, then Compact again, when graphics memory is short (a note says so). Sized for the wind direction: changing the direction rebuilds the grid. Opening sweeps and annual studies use it too. Restarts the solve." />
          </StackPanel>
          <CheckBox x:Name="UpdatesToggle" Click="OnUpdatesToggle" Content="Check for updates automatically"
                    ToolTip.Tip="Asks GitHub for a newer release when WindFlow opens. Nothing about you or your models is sent." />
          <Button x:Name="LogFolderButton" Classes="link" Content="Open log folder" Click="OnOpenLogFolder"
                  HorizontalAlignment="Left" Margin="0,2,0,0" />

          <Border Height="1" Background="{DynamicResource Divider}" Margin="0,2" />
          <TextBlock Classes="section" Text="CONTACT" />
          <TextBlock Classes="rowSub" TextWrapping="Wrap" Text="Questions, ideas or a problem? Tell the creator." />
          <Button x:Name="ContactButton" Classes="tool small accent" Content="Contact the creator" Click="OnContact"
                  HorizontalAlignment="Left" Margin="0,2,0,6"
                  ToolTip.Tip="Opens the WindFlow page on GitHub where you can ask a question or report a problem (Issues)." />
          <TextBlock Classes="section" Text="ABOUT" />
          <TextBlock x:Name="AboutVersionText" Classes="rowName" FontSize="12" Text="WindFlow" />
          <TextBlock x:Name="AboutDisclaimerText" Classes="rowSub" TextWrapping="Wrap" Text="" />
          <TextBlock x:Name="AboutLicenceText" Classes="rowSub" TextWrapping="Wrap"
                     Text="Made by Bijay Karki. Free and open source under the MIT License." />
          <Button x:Name="MethodButton" Classes="link" Content="How WindFlow works (PDF)" Click="OnOpenMethod"
                  HorizontalAlignment="Left" Margin="0,2,0,0"
                  ToolTip.Tip="Opens how-windflow-works.pdf, the 2-page explainer of the method and its limits." />
          <Button x:Name="TechRefButton" Classes="link" Content="Technical Reference (PDF)" Click="OnOpenTechRef"
                  HorizontalAlignment="Left" Margin="0,2,0,0"
                  ToolTip.Tip="Opens WindFlow-Technical-Reference.pdf: the full method, the equations, the validation and the known limits." />
          <Button x:Name="TourButton" Classes="link" Content="Take the tour" Click="OnTakeTour"
                  HorizontalAlignment="Left" Margin="0,2,0,0"
                  ToolTip.Tip="Twelve short steps that point out where things are. It also shows once, on first launch." />
          <Button x:Name="SourceButton" Classes="link" Content="Licence, source code and third-party notices (GitHub)" Click="OnOpenSource"
                  HorizontalAlignment="Left" Margin="0,2,0,0"
                  ToolTip.Tip="Opens github.com/Bijaykars/Windflow: LICENSE.txt, THIRD-PARTY-NOTICES.txt and the source." />
        </StackPanel>
      </Border>
    </Popup>

    <!-- The guided tour (Tour.cs). A popup is its own top-level window, so the dim and the card float above the native
         viewport; its child, the TourOverlay, is built in code and sized to the window. -->
    <Popup x:Name="TourPopup" Grid.Row="2" Placement="AnchorAndGravity" PlacementAnchor="TopLeft" PlacementGravity="BottomRight"
           PlacementConstraintAdjustment="None" IsLightDismissEnabled="False" />

    <!-- ============ status strip: the model, what the solver is doing, the keys, and two quiet facts (Expert) ============ -->
    <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="14,0,12,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="MODEL" FontSize="10" />
          <TextBlock x:Name="ModelText" Text="-" Classes="status" Foreground="{DynamicResource Text}" />
          <TextBlock x:Name="LiveLinkText" Text="" Classes="status" IsVisible="False" />
          <StackPanel x:Name="UpdateBar" Orientation="Horizontal" Spacing="6" IsVisible="False" VerticalAlignment="Center">
            <TextBlock x:Name="UpdateText" Classes="status" Foreground="{DynamicResource Text}" />
            <Button x:Name="UpdateButton" Classes="link" Content="Update and restart" Click="OnUpdateClick" Padding="2,0" />
            <Button x:Name="UpdateDismiss" Classes="link" Content="&#215;" Click="OnUpdateDismiss" Padding="2,0" ToolTip.Tip="Hide this until the next start." />
          </StackPanel>
        </StackPanel>
        <ProgressBar x:Name="SolveProgress" Grid.Column="1" Width="120" Height="3" Margin="16,0,0,0"
                     IsVisible="False" Minimum="0" Maximum="100" VerticalAlignment="Center" />
        <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto" Margin="14,0">
          <TextBlock x:Name="StatusText" Classes="status" TextTrimming="CharacterEllipsis" />
          <Button x:Name="StatusUndoButton" Grid.Column="1" Classes="link" Content="Undo" Click="OnOpeningUndo" IsVisible="False" Padding="2,0" Margin="8,0,0,0"
                  VerticalAlignment="Center" ToolTip.Tip="Put the deleted opening back. Gone with the next edit." />
          <!-- what the keys do right now: follows the selection and the placement mode (RefreshInspector) -->
          <TextBlock x:Name="KeyHints" Grid.Column="2" Classes="status" FontSize="11" Margin="18,0,0,0" Text="" />
        </Grid>
        <Border Grid.Column="3" Classes="chip status" Margin="0,0,8,0" IsVisible="{Binding #GeometryText.IsVisible}">
          <TextBlock x:Name="GeometryText" />
        </Border>
        <Border Grid.Column="4" Classes="chip status" IsVisible="{Binding #PerfText.IsVisible}">
          <TextBlock x:Name="PerfText" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
