<Project Sdk="Microsoft.NET.Sdk">
  <!-- PDF report: images from WindFlow.Viz plus result tables. PdfSharp (MIT) is the only dependency. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindFlow.Core\WindFlow.Core.csproj" />
    <ProjectReference Include="..\WindFlow.Viz\WindFlow.Viz.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
</Project>
